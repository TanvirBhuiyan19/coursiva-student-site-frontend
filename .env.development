# Local development against the mock API (npm run dev starts both). Not secret.
API_URL=http://127.0.0.1:8787
API_SERVICE_TOKEN=dev-service-token
PLATFORM_ROOT_DOMAIN=localhost
REVALIDATE_SECRET=dev-revalidate-secret
NOINDEX_HOSTS=
DEV_DEFAULT_TENANT=amplify
# The mock API keeps the original contract paths/cookie (production defaults: /api/v1/internal/domains/resolve,
# coursiva_learner_session — see src/config/env.ts).
API_RESOLVE_PATH=/platform/v1/domains/resolve
SESSION_COOKIE=coursiva_session
