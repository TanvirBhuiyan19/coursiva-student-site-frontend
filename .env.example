# ── Server-only (never exposed to the browser) ───────────────────────────────
# Laravel API origin. The proxy forwards /api/* and /sanctum/* here so auth cookies stay first-party on the tenant's domain.
API_URL=https://api.example.com
# Token Next.js uses for server-to-server reads (catalog, site config, domain resolution). The plaintext; the API's
# STUDENT_SITE_SERVICE_TOKEN holds sha256:<hex> of it.
API_SERVICE_TOKEN=
# Host resolution on API_URL. Default (Laravel): /api/v1/internal/domains/resolve. The local mock uses /platform/v1/domains/resolve.
API_RESOLVE_PATH=/api/v1/internal/domains/resolve
# The API's learner session cookie (presence gates private pages optimistically). Default (Laravel): coursiva_learner_session.
SESSION_COOKIE=coursiva_learner_session
# Platform root domain: tenants live at <slug>.<root>; anything else is looked up as a custom domain.
# = the API's PLATFORM_TENANT_ROOT_DOMAIN.
PLATFORM_ROOT_DOMAIN=example.com
# Shared secret Laravel signs /hooks/revalidate calls with (HMAC-SHA256 of the raw body). = the API's REVALIDATE_SECRET.
REVALIDATE_SECRET=
# Hosts that must never be indexed (staging, previews). Comma separated, `*.` wildcards allowed.
NOINDEX_HOSTS=*.preview.example.com
# The tenant dashboard's origin(s), comma separated — the only pages allowed to frame the staff course preview
# (/preview/*, frame-ancestors). Unset: http://app.localhost:5174 and http://localhost:5174 in development, nobody in
# production (the preview then only opens in its own tab).
DASHBOARD_ORIGIN=https://app.example.com
# Dev only: tenant served on plain http://localhost:3000.
DEV_DEFAULT_TENANT=
# Server-side page-view reports to the API (no browser script, no cookie). `off` disables them.
ANALYTICS_PAGEVIEWS=on
